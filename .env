# 开发模式配置示例
# 复制此文件为 .env 并根据需要修改

# 设置为 true 启用开发模式（支持热重载）
# 设置为 false 或不设置则为生产模式
DEV_MODE=true

# 其他环境变量可以在这里添加
# SERVER_PORT=3001
# TZ=Asia/Shanghai

# AI Assistant Configuration
# Leave empty to use built-in pattern-based analysis only
AI_API_ENDPOINT=
AI_API_KEY=
AI_MODEL=

# Steam Web API Key (get from https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
